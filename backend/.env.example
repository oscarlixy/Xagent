# Docker Compose overrides this with PostgreSQL from the repository-root .env file.
# PostgreSQL example: postgresql+psycopg://x_digest:password@localhost:5432/x_digest
DATABASE_URL=sqlite+pysqlite:///./x_digest.db
APP_TIMEZONE=UTC
# Optional for direct backend runs. Docker Compose reads X OAuth credentials from the root .env.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/x/callback
# X_TOKEN_ENCRYPTION_KEY=
X_PAGE_SIZE=10
X_MAX_POSTS_PER_SYNC=50
X_MAX_PAGES_PER_SYNC=6
X_INGESTION_BACKFILL_HOURS=24
X_INGESTION_OVERLAP_MINUTES=10
LINK_MAX_ATTEMPTS=3
LINK_MAX_ITEMS_PER_RUN=20
LINK_RETRY_BASE_SECONDS=300
DIGEST_CADENCE=daily
LLM_MAX_ITEMS_PER_RUN=100
# Offline tests use the deterministic provider. For real summaries, use OpenAI with the optional
# Gemini quota fallback. Compose injects GEMINI_API_KEY from the root .env or shell environment.
LLM_PROVIDER=deterministic
LLM_FALLBACK_PROVIDER=none
# OpenAI primary-provider settings.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=low
# Gemini Interactions API settings.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
# LLM_API_KEY=
# GEMINI_API_KEY=  # Only needed for direct runs outside Docker Compose.
# Optional notifications. A channel is enabled only when all required values are set.
NOTIFICATION_FRONTEND_URL=http://127.0.0.1:3000
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_SECONDS=300
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=x-digest@example.com
# SMTP_TO=reader@example.com
# SMTP_STARTTLS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Set only after the X Developer account is available.
# X_BEARER_TOKEN=
