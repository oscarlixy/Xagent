OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=replace-with-a-strong-password
BACKEND_INTERNAL_URL=http://backend:8000
INTERNAL_API_TOKEN=replace-with-the-same-32-byte-random-token-as-the-backend
X_CLIENT_ID=replace-with-your-x-oauth-client-id
X_OAUTH_REDIRECT_URI=https://reader.example.com/api/x/callback
X_OAUTH_STATE_SECRET=replace-with-at-least-32-random-bytes
# Optional; defaults to https://x.com/i/oauth2/authorize
X_OAUTH_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
